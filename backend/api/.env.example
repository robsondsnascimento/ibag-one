DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/ibag_one?schema=public"
JWT_SECRET="gere-uma-chave-aleatoria-com-no-minimo-32-caracteres"
PORT=3000
NODE_ENV=development
# Em produção, informe as origens separadas por vírgula.
CORS_ORIGINS="https://app.ibag.one"
# Defina como false apenas em ambientes onde a documentação não deve ser exposta.
ENABLE_SWAGGER=true
# Diretório persistente para anexos de estudos. Em produção, use o disco do provedor.
STUDY_UPLOADS_DIR="uploads/studies"
# Integrações externas opcionais. Sem URL, cada canal permanece desligado.
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""
PROPRESENTER_WEBHOOK_URL=""
PROPRESENTER_WEBHOOK_TOKEN=""
# Google Calendar institucional compartilhado. Sem todos os valores, a sincronização fica desligada.
GOOGLE_CALENDAR_ID=""
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_TIME_ZONE="America/Sao_Paulo"
